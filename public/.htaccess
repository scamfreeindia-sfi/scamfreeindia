<IfModule mod_rewrite.c>
RewriteEngine On

# 1) Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 2) Force non-www
RewriteCond %{HTTP_HOST} ^www\.scamfreeindia\.com [NC]
RewriteRule ^(.*)$ https://scamfreeindia.com/$1 [L,R=301]

# 3) Allow static files (VERY IMPORTANT)
RewriteCond %{REQUEST_URI} ^/_next/ [OR]
RewriteCond %{REQUEST_URI} \.(css|js|png|jpg|jpeg|gif|svg|ico|webp|woff|woff2|ttf)$
RewriteRule ^ - [L]

# 4) If folder exists → serve index.html inside it
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^(.+)$ /$1/index.html [L]

# 5) If file not found → try .html version
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(.+)$ /$1.html [L]

# 6) Fallback to homepage
RewriteRule ^$ /index.html [L]
</IfModule>